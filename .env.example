NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tenantsea?schema=public

# Auth
JWT_SECRET=change_me_to_a_long_random_secret_at_least_16_chars
JWT_EXPIRES_IN=3600s

# Security / UX
CORS_ORIGINS=http://localhost:3001,http://localhost:5173

# Frontend (used for building password reset links)
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — required on production for automatic invite/reset emails
# Example with Resend: host=smtp.resend.com, port=587, user=resend, pass=re_xxx
EMAIL_ENABLED=false
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@tenantsea.local

# Auth behavior
AUTH_REQUIRE_EMAIL_VERIFICATION=false

# Password hashing
BCRYPT_SALT_ROUNDS=10

